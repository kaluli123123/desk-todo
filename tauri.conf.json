{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskTodo",
  "version": "0.1.0",
  "identifier": "com.vam.desktodo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "待办",
        "width": 900,
        "height": 640,
        "minWidth": 340,
        "minHeight": 300,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
